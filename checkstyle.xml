<?xml version="1.0"?>
<!DOCTYPE module PUBLIC
        "-//Checkstyle//DTD Checkstyle Configuration 1.3//EN"
        "https://checkstyle.org/dtds/configuration_1_3.dtd">

<!--
    Reglas Checkstyle para Pokédex API.
    Basado en Google Java Style, adaptado al proyecto.
    Referencia: https://checkstyle.org/checks.html
-->
<module name="Checker">
    <property name="charset" value="UTF-8"/>
    <property name="severity" value="error"/>
    <property name="fileExtensions" value="java"/>

    <!-- Longitud máxima de línea: 120 caracteres (ignorar imports y package) -->
    <module name="LineLength">
        <property name="max" value="120"/>
        <property name="ignorePattern" value="^package\s|^import\s|^\s*\*\s*https?://|^\s*\*\s*@"/>
    </module>

    <!-- Sin tabuladores en archivos Java (usar espacios) -->
    <module name="FileTabCharacter">
        <property name="eachLine" value="true"/>
        <property name="fileExtensions" value="java"/>
    </module>

    <module name="TreeWalker">

        <!-- ===== IMPORTS ===== -->

        <!-- Sin imports duplicados -->
        <module name="RedundantImport"/>

        <!-- Sin imports no utilizados (excluye star imports, que se controlan por separado) -->
        <module name="UnusedImports">
            <property name="processJavadoc" value="false"/>
        </module>

        <!-- ===== PROHIBICIONES ===== -->

        <!-- Prohibir System.out/err.print — usar @Slf4j -->
        <module name="RegexpSinglelineJava">
            <property name="format" value="System\.(out|err)\.(print|println|printf)"/>
            <property name="message" value="Usar log.info/debug/warn/error (@Slf4j) en lugar de System.out/err"/>
            <property name="ignoreComments" value="true"/>
        </module>

        <!-- ===== BLOQUES Y LLAVES ===== -->

        <!-- Siempre llaves en if/for/while/do -->
        <module name="NeedBraces">
            <property name="tokens" value="LITERAL_IF, LITERAL_ELSE, LITERAL_FOR, LITERAL_WHILE, LITERAL_DO"/>
        </module>

        <!-- Sin bloques catch vacíos sin comentario -->
        <module name="EmptyCatchBlock">
            <property name="exceptionVariableName" value="expected|ignored"/>
        </module>

        <!-- ===== ESPACIADO ===== -->

        <!-- Espacio después de palabras clave (if, for, while...) -->
        <module name="WhitespaceAfter">
            <property name="tokens" value="COMMA, SEMI, TYPECAST"/>
        </module>

        <!-- Sin espacio antes de punto y coma ni coma -->
        <module name="NoWhitespaceBefore">
            <property name="tokens" value="COMMA, SEMI, POST_INC, POST_DEC"/>
        </module>

        <!-- ===== MODIFICADORES ===== -->

        <!-- Orden estándar de modificadores: public/protected/private static final... -->
        <module name="ModifierOrder"/>

        <!-- Sin modificadores redundantes en interfaces -->
        <module name="RedundantModifier"/>

    </module>

</module>
